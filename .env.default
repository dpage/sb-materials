PORT=3000
DATA_DIR=./data
SESSION_SECRET=sb-materials-change-this-secret

# Set TEST_DEPLOYMENT on a pre-production or test installation only. The UI is
# then badged in red on every page and in the window title, and every PDF it
# generates carries a diagonal watermark, so that nothing produced for testing
# can be mistaken for the real thing. Leave it unset (or false) on the live
# service. DEPLOYMENT_LABEL is the wording used in the badge and watermark.
TEST_DEPLOYMENT=false
DEPLOYMENT_LABEL=TEST
